# 生产环境变量模板
# 用法：复制为 mattTest/.env 后填入真实值，并 chmod 600 .env
# 注意：.env 不入 git（含密钥），必须单独备份

# ---- MySQL ----
# 应用连接数据库用的账号密码（compose 会用它创建 supply_chain 用户）
SPRING_DATASOURCE_PASSWORD=__CHANGE_ME_APP_DB_PASSWORD__
# root 密码，执行迁移与备份都要用
MYSQL_ROOT_PASSWORD=__CHANGE_ME_ROOT_PASSWORD__

# ---- MinIO（图片对象存储）----
MINIO_ROOT_USER=__CHANGE_ME_MINIO_USER__
MINIO_ROOT_PASSWORD=__CHANGE_ME_MINIO_PASSWORD__
APP_MEDIA_STORAGE_BUCKET=product-media
# 浏览器直传用的公网地址，必须是外网可访问的 9000 端口
APP_MEDIA_STORAGE_PUBLIC_ENDPOINT=http://__SERVER_IP__:9000

# ---- 后端 ----
# 图片最终展示地址，走后端 8080 代理
APP_MEDIA_PUBLIC_BASE_URL=http://__SERVER_IP__:8080
# 管理端来源，多个用逗号分隔；管理端上线后要加正式域名
APP_ALLOWED_ORIGINS=http://localhost:5173
# 只有上了 HTTPS 才改成 true，否则登录 Cookie 不会被浏览器保存
APP_COOKIE_SECURE=false
SWAGGER_UI_ENABLED=false
